  <model metaid="PBK_PFAS_Recetox_2026" id="PBK_PFAS_Recetox_2026" substanceUnits="MicroGM" timeUnits="DAY" volumeUnits="L" extentUnits="MicroGM">
    <listOfFunctionDefinitions>
      <functionDefinition id="f_BW">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <lambda>
            <bvar>
              <ci> age </ci>
            </bvar>
            <bvar>
              <ci> BW_birth </ci>
            </bvar>
            <apply>
              <plus/>
              <apply>
                <minus/>
                <apply>
                  <plus/>
                  <ci> BW_birth </ci>
                  <apply>
                    <times/>
                    <cn> 4.47 </cn>
                    <ci> age </ci>
                  </apply>
                </apply>
                <apply>
                  <times/>
                  <cn> 0.093 </cn>
                  <apply>
                    <power/>
                    <ci> age </ci>
                    <cn type="integer"> 2 </cn>
                  </apply>
                </apply>
              </apply>
              <apply>
                <times/>
                <cn> 0.00061 </cn>
                <apply>
                  <power/>
                  <ci> age </ci>
                  <cn type="integer"> 3 </cn>
                </apply>
              </apply>
            </apply>
          </lambda>
        </math>
      </functionDefinition>
    </listOfFunctionDefinitions>
