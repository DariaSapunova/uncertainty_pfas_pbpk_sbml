    <listOfRules>
      <assignmentRule variable="Alv">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <cn> 0.03 </cn>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Lung">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VLun </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="SkinSc">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> Vsc </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="SkinTrans">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <cn type="integer"> 1 </cn>
        </math>
      </assignmentRule>
      <assignmentRule variable="SkinVe">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> Vve </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Skin">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VSk </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Ven_Plas">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VvenC </ci>
            <ci> VPlasC </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Art_Plas">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <apply>
            <times/>
            <ci> VartC </ci>
            <ci> VPlasC </ci>
            <ci> BW </ci>
          </apply>
        </math>
      </assignmentRule>
      <assignmentRule variable="Gut">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VInt </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Liv">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VL </ci>
        </math>
      </assignmentRule>
      <assignmentRule variable="Fat">
        <math xmlns="http://www.w3.org/1998/Math/MathML">
          <ci> VAdi </ci>
        </math>
